# Copie para .env e ajuste se necessário.

# Porta da API (o app mobile acessa http://<IP-do-PC>:PORT)
PORT=3333

# Endereço do Ollama rodando localmente
OLLAMA_URL=http://127.0.0.1:11434

# Modelo Llama usado. llama3.2:3b cabe em GPUs de 4 GB; com mais VRAM, teste llama3.1:8b.
OLLAMA_MODEL=llama3.2:3b

# Busca coordenadas reais das sugestões no OpenStreetMap (requer internet).
# Use "off" para rodar 100% offline (usa as coordenadas estimadas pelo modelo).
GEOCODING=on
